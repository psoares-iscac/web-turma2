[
  { "id": 22, "localId": "guincho",    "local": "Praia do Guincho", "data": "2026-10-31T17:40", "autor": "marta.r",    "nota": 2, "texto": "Rajadas muito fortes na zona norte da praia. Kitesurf só para quem tem experiência.", "variavel": "vento",       "observado": 38,  "previsto": 34 },
  { "id": 21, "localId": "supertubos", "local": "Supertubos",       "data": "2026-10-31T16:15", "autor": "joao_s",     "nota": 5, "texto": "Ondas limpas e regulares, pouca gente na água. A previsão acertou.",                  "variavel": "ondas",       "observado": 1.5, "previsto": 1.6 },
  { "id": 20, "localId": "torre",      "local": "Torre",            "data": "2026-10-30T11:02", "autor": "rui.alves",  "nota": 3, "texto": "Mais frio do que o previsto e gelo nas zonas de sombra. Levar luvas.",               "variavel": "temperatura", "observado": 1,   "previsto": 4 },
  { "id": 19, "localId": "pena",       "local": "Trilho da Pena",   "data": "2026-10-30T08:30", "autor": "ines_c",     "nota": 4, "texto": "Nevoeiro cerrado até perto das 10:00, depois abriu. Trilho com lama na descida.",     "variavel": "humidade",    "observado": 90,  "previsto": 88 },
  { "id": 18, "localId": "arrabida",   "local": "Arrábida",         "data": "2026-10-29T15:20", "autor": "pedro.n",    "nota": 5, "texto": "Água transparente e mar flat. Excelente para snorkeling junto ao Portinho.",          "variavel": "ondas",       "observado": 0.3, "previsto": 0.4 },
  { "id": 17, "localId": "guincho",    "local": "Praia do Guincho", "data": "2026-10-29T09:10", "autor": "tiago.lm",   "nota": 4, "texto": "Manhã calma, mar com pouca ondulação. Bom para paddle.",                               "variavel": "vento",       "observado": 15,  "previsto": 14 },
  { "id": 16, "localId": "torre",      "local": "Torre",            "data": "2026-10-28T14:45", "autor": "sofia.m",    "nota": 2, "texto": "Vento muito forte no planalto, difícil andar perto da torre. Nevoeiro a subir.",       "variavel": "vento",       "observado": 52,  "previsto": 41 },
  { "id": 15, "localId": "supertubos", "local": "Supertubos",       "data": "2026-10-28T08:05", "autor": "andre.p",    "nota": 4, "texto": "Boas séries logo de manhã, vento ainda de terra. Às 10:00 já estava cheio.",          "variavel": "ondas",       "observado": 2.1, "previsto": 1.8 },
  { "id": 14, "localId": "pena",       "local": "Trilho da Pena",   "data": "2026-10-27T16:30", "autor": "carla.v",    "nota": 5, "texto": "Tarde de sol e vistas limpas até ao Cabo da Roca. Trilho seco.",                      "variavel": "temperatura", "observado": 19,  "previsto": 18 },
  { "id": 13, "localId": "arrabida",   "local": "Arrábida",         "data": "2026-10-27T12:00", "autor": "miguel.f",   "nota": 4, "texto": "Pouco vento e água a 18 graus. Estacionamento já cheio ao meio-dia.",                 "variavel": "vento",       "observado": 8,   "previsto": 10 },
  { "id": 12, "localId": "guincho",    "local": "Praia do Guincho", "data": "2026-10-26T18:20", "autor": "marta.r",    "nota": 3, "texto": "Nortada a entrar ao fim da tarde, como previsto. Bom para windsurf avançado.",       "variavel": "vento",       "observado": 29,  "previsto": 28 },
  { "id": 11, "localId": "torre",      "local": "Torre",            "data": "2026-10-26T10:15", "autor": "rui.alves",  "nota": 4, "texto": "Céu limpo e frio seco. Primeiros vestígios de geada nas poças.",                     "variavel": "temperatura", "observado": 2,   "previsto": 3 },
  { "id": 10, "localId": "supertubos", "local": "Supertubos",       "data": "2026-10-25T17:00", "autor": "joao_s",     "nota": 2, "texto": "Mar desarrumado com vento de oeste. Não compensou entrar.",                          "variavel": "vento",       "observado": 24,  "previsto": 16 },
  { "id": 9,  "localId": "pena",       "local": "Trilho da Pena",   "data": "2026-10-25T09:40", "autor": "ines_c",     "nota": 3, "texto": "Chuviscos intermitentes e pedras escorregadias. Levar calçado com boa aderência.",    "variavel": "humidade",    "observado": 97,  "previsto": 85 },
  { "id": 8,  "localId": "arrabida",   "local": "Arrábida",         "data": "2026-10-24T14:10", "autor": "pedro.n",    "nota": 5, "texto": "Mar como um lago. Bom para caiaque até à Lapa de Santa Margarida.",                  "variavel": "ondas",       "observado": 0.2, "previsto": 0.3 },
  { "id": 7,  "localId": "guincho",    "local": "Praia do Guincho", "data": "2026-10-24T11:30", "autor": "nuno.b",     "nota": 1, "texto": "Areia a voar com o vento, impossível ficar na praia. Previsão muito abaixo.",         "variavel": "vento",       "observado": 47,  "previsto": 31 },
  { "id": 6,  "localId": "torre",      "local": "Torre",            "data": "2026-10-23T13:25", "autor": "sofia.m",    "nota": 3, "texto": "Nublado com abertas. Temperatura agradável para a altitude.",                        "variavel": "temperatura", "observado": 8,   "previsto": 7 },
  { "id": 5,  "localId": "supertubos", "local": "Supertubos",       "data": "2026-10-23T07:50", "autor": "andre.p",    "nota": 5, "texto": "Tubos perfeitos ao nascer do sol. Um dos melhores dias do mês.",                     "variavel": "ondas",       "observado": 2.4, "previsto": 2.3 },
  { "id": 4,  "localId": "pena",       "local": "Trilho da Pena",   "data": "2026-10-22T15:00", "autor": "carla.v",    "nota": 4, "texto": "Nevoeiro na serra, mas sem chuva. Ambiente misterioso no Chalet da Condessa.",       "variavel": "humidade",    "observado": 92,  "previsto": 90 },
  { "id": 3,  "localId": "arrabida",   "local": "Arrábida",         "data": "2026-10-22T10:20", "autor": "miguel.f",   "nota": 3, "texto": "Alguma ondulação à entrada da baía, mas protegido junto à praia.",                   "variavel": "ondas",       "observado": 0.8, "previsto": 0.5 },
  { "id": 2,  "localId": "guincho",    "local": "Praia do Guincho", "data": "2026-10-21T16:45", "autor": "tiago.lm",   "nota": 4, "texto": "Vento moderado e constante. Muitas velas de kite na água.",                          "variavel": "vento",       "observado": 25,  "previsto": 23 },
  { "id": 1,  "localId": "torre",      "local": "Torre",            "data": "2026-10-21T09:00", "autor": "rui.alves",  "nota": 2, "texto": "Chuva gelada e visibilidade reduzida. Estrada com cuidado.",                         "variavel": "temperatura", "observado": 0,   "previsto": 3 }
]
